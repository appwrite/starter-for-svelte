    "prettier-plugin-svelte": "^3.3.3",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.0",
    "vite": "^8.0.12"
  },
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "dependencies": {
    "@appwrite.io/pink-icons": "^0.26.0",
    "@sveltejs/adapter-node": "^6.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "appwrite": "^21.0.0",
    "tailwindcss": "^4.1.3"
